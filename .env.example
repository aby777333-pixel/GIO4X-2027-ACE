# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin for this environment (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.gio4x.com
# "production" enables indexing. Anything else serves noindex and a disallow-all robots.txt.
NEXT_PUBLIC_SITE_ENV=development

# ── Supabase (project wcdhqykhvnlxozayeolt) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://wcdhqykhvnlxozayeolt.supabase.co
# Publishable key. Safe for the browser: row-level security is the control.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Version label of the Privacy Policy published at /legal/privacy. Stored with each
# consent record; "unversioned" is recorded when empty.
PRIVACY_POLICY_VERSION=

# ── Client / IB portal (the portal/ folder), served by this site at /portal ──
# Address of the portal's own deployment; this site proxies /portal to it.
# https only (http://localhost:3100 is accepted for local development).
# Production value is in netlify.toml. Empty = portal not connected.
PORTAL_ORIGIN=

# The portal's database, read on the server by Control's portal sections
# (KYC, Funds, Trade Log, ...). The URL is public; the key is a SECRET: it
# bypasses the portal's row-level security. Hosting environment only, never
# committed, never NEXT_PUBLIC_. Empty = those sections say "not connected".
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_SECRET_KEY=

# ── Portal gateway overrides: only to send a destination somewhere else ──────
# Each must be https and on gio4x.com or a host listed in NEXT_PUBLIC_OFFICIAL_PORTAL_HOSTS.
CLIENT_PORTAL_URL=
TRADER_PORTAL_URL=
IB_PORTAL_URL=
ACCOUNT_OPENING_URL=
NEXT_PUBLIC_OFFICIAL_PORTAL_HOSTS=

# ── GIO4X AI: provider adapter. The site works fully without it ──────────────
ANTHROPIC_API_KEY=
GIO4X_AI_MODEL=

# ── Search engine verification (optional) ────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
