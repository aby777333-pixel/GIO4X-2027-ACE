# ============================================================================
# GIO4X-JUNE-2026 — ENVIRONMENT TEMPLATE
# Copy to .env.local (per app) and fill in. NEVER commit real values.
# Public (browser-exposed) keys are prefixed NEXT_PUBLIC_. Everything else is
# server-only and must NEVER reach a client bundle.
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE — project tdifcayznqnaduchzfqz
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tdifcayznqnaduchzfqz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Bypasses RLS — used ONLY in server actions / route handlers / edge
# functions. If this ever appears in client code, that is a security bug.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# For local migrations / CLI (supabase db push). Project ref + DB password.
SUPABASE_PROJECT_REF=tdifcayznqnaduchzfqz
SUPABASE_DB_PASSWORD=your-db-password-here

# ----------------------------------------------------------------------------
# AUTH / SESSION
# ----------------------------------------------------------------------------
# Base URL of the running app (used for email links, OAuth redirects, PKCE).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Failed-login lockout policy (Phase B edge cases).
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ----------------------------------------------------------------------------
# SMS / OTP  (packages/supabase/sms.ts adapter — swap provider here)
# Provider: stub | twilio | msg91 | supabase
# ----------------------------------------------------------------------------
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=GIO4X

# ----------------------------------------------------------------------------
# EMAIL  (verify / welcome / reset templates)
# Provider: supabase | resend | smtp
# ----------------------------------------------------------------------------
EMAIL_PROVIDER=supabase
EMAIL_API_KEY=
EMAIL_FROM="GIO4X <no-reply@gio4x.com>"

# ----------------------------------------------------------------------------
# PAYMENTS  (payment adapter interface — fiat + crypto)
# Fill only the gateways you enable. All server-only.
# ----------------------------------------------------------------------------
PAYMENT_FIAT_PROVIDER=stub
PAYMENT_FIAT_KEY=
PAYMENT_FIAT_SECRET=

PAYMENT_CRYPTO_PROVIDER=stub
PAYMENT_CRYPTO_KEY=
PAYMENT_CRYPTO_SECRET=

# ----------------------------------------------------------------------------
# MARKET DATA / EXECUTION  (apps/platform — typed adapter, stub before live)
# ----------------------------------------------------------------------------
MARKET_DATA_PROVIDER=stub
MARKET_DATA_API_KEY=
MARKET_DATA_WS_URL=

# ----------------------------------------------------------------------------
# AI INSIGHTS / SIGNALS  (optional — NEXUS-style co-pilot, server-only)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=GIORAPTOR
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
