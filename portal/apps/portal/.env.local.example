# Base URL of the running app — used for email confirmation links, OAuth
# redirects and PKCE (apps/portal/src/lib/auth-actions.ts siteUrl()).
# MUST be set to the real origin in production, e.g. https://app.gio4x.com.
# If unset it falls back to http://localhost:3000, which breaks live signup
# confirmation links. The same value must be allow-listed in the Supabase
# project's Auth → URL Configuration (Site URL + Redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
